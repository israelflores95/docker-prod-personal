{
	# DNS-01 challenge via Cloudflare: proves domain ownership with a TXT
	# record instead of a reachable port 80/443, so this works behind CGNAT
	# and issues a real, browser-trusted cert for internal HTTPS too.
	acme_dns cloudflare {$CLOUDFLARE_DNS_API_TOKEN}
}

