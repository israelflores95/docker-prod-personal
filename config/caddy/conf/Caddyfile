	reverse_proxy jellyfin:8096
}

sonarr.{$DOMAIN}:80 {
	reverse_proxy sonarr:8989
}

radarr.{$DOMAIN}:80 {
	reverse_proxy radarr:7878
}

qbittorrent.{$DOMAIN}:80 {
	reverse_proxy vpn:8080
}

prowlarr.{$DOMAIN}:80 {
	reverse_proxy vpn:9696
}
