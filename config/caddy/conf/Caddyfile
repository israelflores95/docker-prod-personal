{
	# Cloudflare Tunnel already terminates public HTTPS at the edge, so Caddy
	# only needs to speak plain HTTP internally over cf-tunnel. Behind CGNAT,
	# Caddy can't complete an ACME HTTP-01 challenge anyway.
	auto_https off
}

dashboard.{$DOMAIN}:80 {
	reverse_proxy homarr:7575
}

