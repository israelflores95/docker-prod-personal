# --- CLOUDFLARE CONFIGURATION ---
# Obtain your token from the Cloudflare Zero Trust Dashboard
# (Networks > Tunnels > Create a Tunnel > Choose Docker for the connector)
CLOUDFLARE_TUNNEL_TOKEN=your_token_here

# Your base domain
DOMAIN=casa-flores.net

# --- TRAEFIK / TLS CONFIGURATION ---
# API token for Traefik's DNS-01 cert issuance (Cloudflare > My Profile > API Tokens).
# Scope it to Zone:DNS:Edit for this zone only - do NOT reuse the tunnel token here.
CLOUDFLARE_DNS_API_TOKEN=your_dns_api_token_here

# Email for Let's Encrypt certificate expiry notices
ACME_EMAIL=you@example.com

# --- SYSTEM SETTINGS ---
# Use 'id $USER' to find your PUID and PGID
PUID=1000
PGID=1000
TZ=America/Denver


# --- DIRECTORY PATHS ---
# Relative paths for container data persistence
DOCKER_CONFIG_DIR=./config
DOCKER_DATA_DIR=./data

# Path to your mounted media (e.g., /mnt/truenas/media)
DOCKER_MEDIA_DIR=/mnt/truenas/media

# --- VPN SETTINGS (PROTONVPN) ---
# Get your WireGuard Private Key from account.protonvpn.com
PROTONVPN_WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here
